# config/template.env — schema for forking agentic-inbox to a new operator.
#
# Copy this to config/<env>.env (e.g. config/production.env) and fill in:
#
#   1. Identity values (WORKER_NAME, EMAIL_DOMAIN).
#   2. Run `mise run cf:provision-d1-r2`   — creates R2 (skips D1: not used).
#   3. Run `mise run cf:access-setup`      — creates Access App + writes fnox values.
#   4. Run `mise run cf:secrets-put-mapped` — pushes Worker secrets from fnox.
#   5. Run `mise run 10-deploy`.
#   6. Configure CF Email Routing in dashboard (catch-all → this Worker).
#
# DO NOT COMMIT config/<env>.env — they're gitignored.

# ── Identity ─────────────────────────────────────────────────────────────────

WORKER_NAME=agentic-inbox
CF_SUBDOMAIN=gedw99

# Comma-separated domains the Worker will receive email for. Must be on
# Cloudflare with Email Routing enabled. Used by upstream's mailbox creation
# guardrails (DOMAINS env var).
EMAIL_DOMAIN=example.com

# ── Cloudflare resources (set/updated by `mise run cf:provision-*`) ──────────

# agentic-inbox uses per-mailbox DurableObject SQLite — NO central D1.
METADATA_DB_NAME=
METADATA_DB_ID=

# R2 bucket for mailbox config + attachment storage.
BACKUP_BUCKET_NAME=agentic-inbox

# No Queues used today (left blank → cf:provision-queues no-ops).
QUEUE_NAMES=

# ── Cloudflare Account / Access ──────────────────────────────────────────────

# CLOUDFLARE_ACCOUNT_ID comes from fnox; envsubst pulls it via env.
CLOUDFLARE_ACCOUNT_ID=

OPERATOR_EMAIL=gedw99@gmail.com

# Subset of fnox keys to also sync to GitHub Actions secrets (CI deploys).
FNOX_SYNC_KEYS=

# Per-Worker fnox keys for cf:access-setup and cf:secrets-put-mapped.
APP_POLICY_AUD_FNOX_KEY=AGENTIC_INBOX_POLICY_AUD
